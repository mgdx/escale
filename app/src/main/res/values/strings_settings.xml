<?xml version="1.0" encoding="utf-8"?>
<!-- Chaînes de l'écran de réglages et de l'écran « Serveur MOTIS » (SPEC.md § 5.6 et § 5.6.1). -->
<resources>
  <string name="settings_title">Settings</string>
  <string name="settings_server_title">MOTIS server</string>

  <!--
    Actions partagées par les écrans de réglages. Elles vivent ici plutôt que dans strings.xml pour
    ne pas entrer en collision avec les actions génériques d'un autre lot
    (docs/architecture.md § 3, règle 2).
  -->
  <string name="settings_action_cancel">Cancel</string>
  <string name="settings_action_opens_externally">Opens in another app</string>

  <string name="settings_action_close">Close</string>
  <string name="settings_action_done">Done</string>
  <string name="settings_action_delete">Clear</string>
  <string name="settings_action_reset">Restore</string>
  <!-- Sépare deux valeurs énumérées sur une même ligne. -->
  <string name="settings_value_separator">, </string>

  <!-- Rubriques (SPEC.md § 5.6). -->
  <string name="settings_section_search">Search preferences</string>
  <string name="settings_section_display">Display</string>
  <string name="settings_section_data">Data</string>

  <!-- Vitesse de marche. Les libellés donnent l'allure et l'ordre de grandeur : personne ne
       connaît sa vitesse de marche en mètres par seconde, qui est l'unité de l'API. -->
  <string name="settings_walking_speed_title">Walking speed</string>
  <string name="settings_walking_speed_description">How fast Escale assumes you walk. A slower speed makes walking legs longer and rules out tight transfers.</string>
  <string name="settings_walking_speed_very_slow">Very slow, about 3 km/h</string>
  <string name="settings_walking_speed_slow">Slow, about 3.6 km/h</string>
  <string name="settings_walking_speed_normal">Normal, about 4.3 km/h</string>
  <string name="settings_walking_speed_fast">Fast, about 5 km/h</string>
  <string name="settings_walking_speed_very_fast">Very fast, about 6 km/h</string>

  <!-- Profil piéton, exigé par SPEC.md § 9 pour l'accessibilité en fauteuil. -->
  <string name="settings_pedestrian_profile_title">Walking profile</string>
  <string name="settings_pedestrian_profile_description">Wheelchair mode avoids stairs, steps and paths that are too steep or too narrow. It changes the route itself, not only what is displayed.</string>
  <string name="settings_pedestrian_profile_foot">On foot</string>
  <string name="settings_pedestrian_profile_wheelchair">Wheelchair</string>

  <string name="settings_cycling_speed_title">Cycling speed</string>
  <string name="settings_cycling_speed_description">How fast Escale assumes you cycle, on your own bike as well as on a shared one.</string>
  <string name="settings_cycling_speed_very_slow">Very slow, about 12 km/h</string>
  <string name="settings_cycling_speed_slow">Slow, about 15 km/h</string>
  <string name="settings_cycling_speed_normal">Normal, about 18 km/h</string>
  <string name="settings_cycling_speed_fast">Fast, about 22 km/h</string>
  <string name="settings_cycling_speed_very_fast">Very fast, about 26 km/h</string>

  <!-- « Coût du dénivelé » ne veut rien dire seul : le libellé dit l'effet, pas le paramètre. -->
  <string name="settings_elevation_costs_title">Hills when cycling</string>
  <string name="settings_elevation_costs_description">How far a cycling route may go out of its way to avoid a climb. Avoiding hills gives flatter but longer journeys.</string>
  <string name="settings_elevation_costs_none">Ignore hills</string>
  <string name="settings_elevation_costs_low">Avoid the steepest climbs</string>
  <string name="settings_elevation_costs_high">Avoid climbs as much as possible</string>

  <string name="settings_transfer_margin_title">Extra transfer time</string>
  <string name="settings_transfer_margin_description">Added to every transfer, on top of the time the operator allows. Useful when walking between platforms takes you longer.</string>
  <string name="settings_transfer_margin_none">No extra time</string>
  <plurals name="settings_transfer_margin_minutes">
    <item quantity="one">%1$d extra minute</item>
    <item quantity="other">%1$d extra minutes</item>
  </plurals>

  <string name="settings_max_transfers_title">Maximum number of transfers</string>
  <string name="settings_max_transfers_description">Journeys with more transfers than this are not offered. Fewer transfers usually mean a longer journey.</string>
  <string name="settings_max_transfers_unlimited">No limit</string>
  <string name="settings_max_transfers_none">Direct journeys only</string>
  <plurals name="settings_max_transfers_count">
    <item quantity="one">%1$d transfer at most</item>
    <item quantity="other">%1$d transfers at most</item>
  </plurals>

  <string name="settings_require_bike_transport_title">Only services that carry bikes</string>
  <string name="settings_require_bike_transport_description">Keeps only trains, buses and boats that take bicycles on board.</string>

  <!-- Le filtre unique de SPEC.md § 5.2 : exclure un type de véhicule le retire partout. -->
  <string name="settings_rental_form_factors_title">Shared vehicles</string>
  <string name="settings_rental_form_factors_description">Which shared vehicles Escale may suggest, for a whole journey as well as to and from a stop. A type left unticked never shows up anywhere. At least one type must stay ticked.</string>
  <string name="settings_rental_form_factors_all">All types accepted</string>
  <string name="settings_rental_bicycle">Bike</string>
  <string name="settings_rental_cargo_bicycle">Cargo bike</string>
  <string name="settings_rental_car">Car</string>
  <string name="settings_rental_moped">Moped</string>
  <string name="settings_rental_scooter_standing">Standing scooter</string>
  <string name="settings_rental_scooter_seated">Seated scooter</string>
  <string name="settings_rental_other">Other vehicle</string>

  <!-- Affichage (SPEC.md § 5.6). -->
  <string name="settings_theme_title">Theme</string>
  <string name="settings_theme_description">Light or dark colours, whatever the time of day.</string>
  <string name="settings_theme_system">Same as the system</string>
  <string name="settings_theme_light">Light</string>
  <string name="settings_theme_dark">Dark</string>

  <!--
    Langue de l'application (SPEC.md § 5.6). L'entrée n'apparaît qu'à partir d'Android 13, la
    première version qui sache attribuer une langue à une seule application ; en deçà elle est
    masquée et l'application suit la langue de l'appareil.
  -->
  <string name="settings_language_title">Language</string>
  <string name="settings_language_description">Pick the language Escale is displayed in, on Android\'s own “App language” screen. Escale follows your device language until you change it there.</string>
  <!-- Quand aucun écran de langue ne répond : l'appui doit dire quelque chose. -->
  <string name="settings_language_unavailable">This device has no app language screen. You can still change the language of every app in Android settings.</string>

  <string name="settings_clock_format_title">Time format</string>
  <string name="settings_clock_format_description">How departure and arrival times are written.</string>
  <string name="settings_clock_format_system">Same as the system</string>
  <string name="settings_clock_format_12">12-hour clock (1:30 pm)</string>
  <string name="settings_clock_format_24">24-hour clock (13:30)</string>

  <!-- Couches de la carte, indépendantes du zoom (SPEC.md § 5.7). -->
  <string name="settings_show_stops_title">Show stops on the map</string>
  <string name="settings_show_stops_description">Stations and stops, once the map is zoomed in enough. Turning this off hides them at every zoom level.</string>
  <string name="settings_show_rentals_title">Show shared vehicles on the map</string>
  <string name="settings_show_rentals_description">Docking stations and free-floating vehicles.</string>
  <string name="settings_show_points_of_interest_title">Show points of interest on the map</string>
  <string name="settings_show_points_of_interest_description">Public services, landmarks, parks and facilities that help you find your way.</string>

  <!-- Données (SPEC.md § 5.6). Chaque effacement dit ce qu'il supprime avant de le faire. -->
  <!-- Entrée vers l'écran des favoris et de l'historique (SPEC.md § 5.5). -->
  <string name="settings_favorites_title">Favourites and history</string>
  <string name="settings_favorites_description">Home, work, saved places, stops, journeys and recent searches.</string>

  <string name="settings_history_enabled_title">Keep recent searches</string>
  <string name="settings_history_enabled_description">Your recent searches stay on this device and are never sent anywhere.</string>

  <string name="settings_clear_history_title">Clear recent searches</string>
  <string name="settings_clear_history_description">Deletes the list of places you have searched for.</string>
  <string name="settings_clear_history_confirmation">The list of places you have searched for will be deleted from this device. Your favourites are kept.</string>

  <string name="settings_clear_tile_cache_title">Clear the map cache</string>
  <string name="settings_clear_tile_cache_description">Frees the space taken by map tiles already downloaded.</string>
  <string name="settings_clear_tile_cache_confirmation">The map tiles stored on this device will be deleted. The map will download them again as you move around.</string>

  <string name="settings_clear_results_cache_title">Clear saved results</string>
  <string name="settings_clear_results_cache_description">Journeys kept in memory for the search in progress.</string>
  <string name="settings_clear_results_cache_confirmation">The journeys kept in memory for the search in progress will be deleted. The next search will ask the server again.</string>

  <!-- Ce cache est sur le disque et survit à la fermeture de l'application, à la différence de
       celui des résultats : le libellé le dit, c'est ce qui compte pour la vie privée. -->
  <string name="settings_clear_geocode_cache_title">Clear saved places</string>
  <string name="settings_clear_geocode_cache_description">Addresses and stops found while searching, kept for 24 hours in the device\'s storage.</string>
  <string name="settings_clear_geocode_cache_confirmation">The addresses and stops found while searching, kept on this device for 24 hours, will be deleted.</string>

  <string name="settings_reset_title">Restore default settings</string>
  <string name="settings_reset_description">Puts every setting on this screen back to its original value.</string>
  <string name="settings_reset_confirmation">Every setting on this screen goes back to its original value. The configured server, your favourites and your recent searches are kept.</string>

  <!-- Retours affichés après une action. Ils ne nomment jamais une donnée effacée. -->
  <string name="settings_cleared_history">Recent searches deleted.</string>
  <string name="settings_cleared_tile_cache">Map cache cleared.</string>
  <string name="settings_cleared_results_cache">Saved results deleted.</string>
  <string name="settings_cleared_geocode_cache">Saved places deleted.</string>
  <string name="settings_clear_failed">Nothing could be deleted. Try again.</string>
  <string name="settings_reset_done">Settings restored.</string>
  <string name="settings_save_failed">This setting could not be saved.</string>

  <!-- Écran « Serveur MOTIS » (SPEC.md § 5.6.1). -->
  <string name="server_settings_title">MOTIS server</string>
  <string name="server_settings_current_label">Server in use</string>
  <string name="server_settings_url_label">Server address</string>
  <string name="server_settings_url_hint">Enter the root address of the server. Escale appends the API and map tile paths itself.</string>
  <string name="server_settings_url_normalized">Will be saved as %1$s</string>
  <string name="server_settings_url_invalid">This is not a usable server address.</string>
  <string name="server_settings_paste">Paste the address from the clipboard</string>
  <string name="server_settings_test">Test the connection</string>
  <string name="server_settings_save">Use this server</string>
  <string name="server_settings_use_anyway">Use anyway</string>
  <string name="server_settings_reset_default">Restore the default server</string>

  <!-- Les trois étapes du test de connexion, affichées séparément. -->
  <string name="server_settings_test_results">Connection test</string>
  <string name="server_settings_check_reachable">Server reachable</string>
  <string name="server_settings_check_api">API version supported</string>
  <string name="server_settings_check_tiles">Map tiles served</string>
  <string name="server_settings_step_idle">Not tested yet</string>
  <string name="server_settings_step_running">In progress…</string>
  <string name="server_settings_step_passed">Passed</string>
  <string name="server_settings_step_failed">Failed</string>
  <string name="server_settings_step_absent">Not available</string>
  <string name="server_settings_tiles_absent_notice">This server serves no map tiles. Escale remains usable: the map simply has no background.</string>

  <!-- Serveurs déjà utilisés. La suppression se fait au balayage ou par l'action d'accessibilité
       « Retirer » posée sur la ligne (SPEC.md § 9) : la phrase d'aide nomme les deux, sans quoi
       elle décrirait un geste inatteignable comme la seule voie d'accès. -->
  <string name="server_settings_known_title">Servers already used</string>
  <string name="server_settings_known_empty">No server has been used yet.</string>
  <string name="server_settings_known_in_use">In use</string>
  <string name="server_settings_known_swipe_hint">Tap a server to switch to it. To remove it, swipe it sideways or use its “Remove” action.</string>
  <string name="server_settings_forget">Remove</string>

  <!-- Avertissement sur le trafic en clair (docs/architecture.md § 11.1). -->
  <string name="server_settings_cleartext_title">Unencrypted connection</string>
  <string name="server_settings_cleartext_message">%1$s is contacted over http://, without encryption. Anyone on the network can read or alter what Escale sends and receives, including the places you search for. Only accept this for a server on a network you trust.</string>
  <string name="server_settings_cleartext_accept">Accept and continue</string>

  <!-- Effets d'un changement de serveur, annoncés avant confirmation. -->
  <string name="server_settings_switch_title">Change server?</string>
  <string name="server_settings_switch_message">Escale will use %1$s. The result, geocoding and map tile caches are emptied.</string>
  <string name="server_settings_switch_favorites">Your favourites and history are kept. A stop saved as a favourite may not be known to the new server: it stays in the list with its coordinates and a discreet warning, and is never deleted.</string>
  <string name="server_settings_switch_untested">This server has not passed the connection test. Searches may not work.</string>
  <string name="server_settings_switch_confirm">Change server</string>

  <!-- Pied de page : la politique d'usage de l'instance publique (SPEC.md § 4.2). -->
  <string name="server_settings_public_instance_notice">The default server, api.transitous.org, is a public instance run by volunteers at their own expense. Please use it sparingly.</string>
  <string name="server_settings_policy_link">Transitous usage policy</string>
  <string name="server_settings_policy_url" translatable="false">https://transitous.org/api/</string>
</resources>
