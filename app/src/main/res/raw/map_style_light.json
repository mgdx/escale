{
  "version": 8,
  "name": "Escale clair",
  "sources": {
    "motis": {
      "type": "vector",
      "tiles": [
        "__BASE_URL__/tiles/{z}/{x}/{y}.mvt"
      ],
      "maxzoom": 15,
      "attribution": "© OpenStreetMap"
    }
  },
  "glyphs": "__BASE_URL__/glyphs/{fontstack}/{range}.pbf",
  "sprite": "__BASE_URL__/sprites/basics/sprites",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8f4f0"
      }
    },
    {
      "id": "coastline",
      "type": "fill",
      "source": "motis",
      "source-layer": "coastline",
      "paint": {
        "fill-color": "#a8d8f0"
      }
    },
    {
      "id": "land-urban",
      "type": "fill",
      "source": "motis",
      "source-layer": "land",
      "filter": [
        "match",
        [
          "get",
          "kind"
        ],
        [
          "residential",
          "industrial",
          "commercial",
          "retail",
          "railway",
          "landfill",
          "brownfield",
          "greenfield",
          "quarry",
          "garages",
          "farmyard",
          "farmland",
          "public_transport"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#eee8e2"
      }
    },
    {
      "id": "land-green",
      "type": "fill",
      "source": "motis",
      "source-layer": "land",
      "filter": [
        "match",
        [
          "get",
          "kind"
        ],
        [
          "forest",
          "scrub",
          "grass",
          "meadow",
          "grassland",
          "heath"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#c6e3b5"
      }
    },
    {
      "id": "land-park",
      "type": "fill",
      "source": "motis",
      "source-layer": "land",
      "filter": [
        "match",
        [
          "get",
          "kind"
        ],
        [
          "park",
          "garden",
          "village_green",
          "recreation_ground",
          "playground",
          "golf_course",
          "miniature_golf",
          "allotments",
          "greenhouse_horticulture",
          "orchard",
          "vineyard",
          "plant_nursery"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#bfe8ae"
      }
    },
    {
      "id": "land-cemetery",
      "type": "fill",
      "source": "motis",
      "source-layer": "land",
      "filter": [
        "match",
        [
          "get",
          "kind"
        ],
        [
          "cemetery",
          "grave_yard"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#d4dbc4"
      }
    },
    {
      "id": "land-sand",
      "type": "fill",
      "source": "motis",
      "source-layer": "land",
      "filter": [
        "match",
        [
          "get",
          "kind"
        ],
        [
          "sand",
          "beach",
          "bare_rock",
          "scree",
          "shingle"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#f2e7c8"
      }
    },
    {
      "id": "land-wetland",
      "type": "fill",
      "source": "motis",
      "source-layer": "land",
      "filter": [
        "match",
        [
          "get",
          "kind"
        ],
        [
          "swamp",
          "bog",
          "string_bog",
          "wet_meadow",
          "marsh"
