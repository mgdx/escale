      "source": "motis",
      "source-layer": "water_polygons",
      "paint": {
        "fill-color": "#a8d8f0"
      }
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "motis",
      "source-layer": "water_lines",
      "minzoom": 9,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#8fc4e0",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0.6,
          13,
          1.4,
          17,
          4
        ]
      }
    },
    {
      "id": "sites",
      "type": "fill",
      "source": "motis",
      "source-layer": "sites",
      "minzoom": 13,
      "filter": [
        "!=",
        [
          "get",
          "kind"
        ],
        "construction"
      ],
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "kind"
          ],
          "hospital",
          "#e05252",
          "sports_center",
          "#d5eec6",
          "#e8e0d8"
        ],
        "fill-opacity": [
          "match",
          [
            "get",
            "kind"
          ],
          "hospital",
          0.1,
          0.7
        ]
      }
    },
    {
      "id": "street-polygons",
      "type": "fill",
      "source": "motis",
      "source-layer": "street_polygons",
      "minzoom": 13,
      "paint": {
        "fill-color": "#ece7e1"
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "motis",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": {
        "fill-color": "#ded7d3",
        "fill-outline-color": "#cdc4bf",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          14,
          0.5,
          16,
          1
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "motis",
      "source-layer": "streets",
      "minzoom": 5,
      "filter": [
        "!=",
        [
          "get",
          "rail"
        ],
        true
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "kind"
          ],
          "motorway",
          "#f6ae62",
          "trunk",
          "#f8c48c",
          [
            "primary",
            "secondary"
          ],
          "#f6d97a",
          "tertiary",
          "#f4e9b4",
          [
            "residential",
            "living_street",
            "unclassified",
            "pedestrian",
            "busway"
          ],
          "#ffffff",
          "#f4f2ef"
        ],
        "line-opacity": [
          "case",
          [
            "==",
            [
              "get",
              "tunnel"
            ],
            true
          ],
          0.5,
          1
        ],
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          6,
          [
            "match",
            [
              "get",
              "kind"
            ],
            "motorway",
            1.0,
            "trunk",
            0.8,
            [
              "primary",
              "secondary"
            ],
            0.5,
            "tertiary",
            0.3,
            [
              "residential",
              "living_street",
              "unclassified",
              "pedestrian",
              "busway"
            ],
            0.2,
            0.2
          ],
          10,
          [
            "match",
            [
              "get",
              "kind"
            ],
            "motorway",
            2.2,
            "trunk",
            1.8,
            [
              "primary",
              "secondary"
            ],
            1.3,
            "tertiary",
            0.9,
            [
              "residential",
              "living_street",
              "unclassified",
              "pedestrian",
              "busway"
            ],
            0.5,
            0.4
          ],
          14,
          [
            "match",
            [
              "get",
              "kind"
            ],
            "motorway",
            5.0,
            "trunk",
            4.2,
            [
              "primary",
              "secondary"
            ],
            3.4,
            "tertiary",
            2.6,
            [
              "residential",
              "living_street",
              "unclassified",
              "pedestrian",
              "busway"
            ],
            2.0,
            1.3
          ],
          18,
          [
            "match",
            [
              "get",
              "kind"
            ],
            "motorway",
            20.0,
            "trunk",
            17.0,
            [
              "primary",
              "secondary"
            ],
            14.0,
            "tertiary",
            11.0,
            [
              "residential",
              "living_street",
              "unclassified",
              "pedestrian",
              "busway"
            ],
            8.0,
            5.0
          ]
        ]
      }
    },
    {
      "id": "rails",
      "type": "line",
      "source": "motis",
      "source-layer": "streets",
      "minzoom": 8,
      "filter": [
