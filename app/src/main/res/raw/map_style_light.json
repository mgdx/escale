            "==",
            [
              "get",
              "tunnel"
            ],
            true
          ],
          0.4,
          1
        ],
        "line-dasharray": [
          3,
          2
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.5,
          13,
          1.2,
          18,
          3
        ]
      }
    },
    {
      "id": "ferries",
      "type": "line",
      "source": "motis",
      "source-layer": "ferries",
      "minzoom": 7,
      "paint": {
        "line-color": "#7fb3d5",
        "line-dasharray": [
          2,
          3
        ],
        "line-width": 1.2
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "motis",
      "source-layer": "boundaries",
      "filter": [
        "all",
        [
          "has",
          "admin_level"
        ],
        [
          "<=",
          [
            "get",
            "admin_level"
          ],
          4
        ]
      ],
      "paint": {
        "line-color": "#9c93a8",
        "line-dasharray": [
          4,
          3
        ],
        "line-opacity": 0.6,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          0.6,
          8,
          1.2,
          12,
          1.8
        ]
      }
    },
    {
      "id": "street-labels",
      "type": "symbol",
      "source": "motis",
      "source-layer": "streets",
      "minzoom": 15,
      "filter": [
        "all",
        [
          "!=",
          [
            "get",
            "name"
          ],
          ""
