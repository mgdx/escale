<?xml version="1.0" encoding="utf-8"?>
<!--
  Sauvegarde d'avant Android 12 : **rien n'est sauvegardé**.

  `android:allowBackup="false"` suffit déjà à tout couper sur ces versions ; ce fichier existe pour
  deux raisons, et pas une de plus :

  1. lint exige que `android:dataExtractionRules` (Android 12 et plus) soit accompagné d'un
     `android:fullBackupContent` tant que `minSdk` est inférieur à 31 — c'est notre cas (26) ;
  2. il dit explicitement ce que le gabarit d'Android Studio laissait deviner. Un relecteur lit
     « exclude » et « allowBackup=false » et sait en dix secondes que rien ne sort de l'appareil
     (SPEC.md § 11).

  Voir `data_extraction_rules.xml` pour Android 12 et plus, transfert d'appareil à appareil compris.
-->
<full-backup-content>
  <exclude domain="root" path="." />
  <exclude domain="file" path="." />
  <exclude domain="database" path="." />
  <exclude domain="sharedpref" path="." />
  <exclude domain="external" path="." />
</full-backup-content>
