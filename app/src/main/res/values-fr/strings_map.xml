  <!-- Infobulle d'un arrêt : le nom, les lignes desservies, et le chemin vers les départs. -->
  <plurals name="map_stop_lines_served">
    <item quantity="one">%d ligne desservie</item>
    <!-- Catégorie CLDR « many » du français : elle ne vaut que pour les millions (1000000,
         2000000…), et lint l'exige dès qu'un pluriel porte un nombre. La construction « 2 millions
         DE X » suppose le nombre écrit en toutes lettres ; avec %d, qui rend « 2000000 », elle
         serait fautive. La forme reprend donc « other ». -->
    <item quantity="many">%d lignes desservies</item>
    <item quantity="other">%d lignes desservies</item>
  </plurals>
  <string name="map_stop_lines_loading">Chargement des lignes\u2026</string>
  <string name="map_stop_lines_unavailable">Les lignes n\'ont pas pu être chargées.</string>
