<?xml version="1.0" encoding="utf-8"?>
<!--
  Chaînes des trajets surveillés (SPEC.md § 5.5.1), écran d'activation et notifications.
  Une chaîne ajoutée ici l'est aussi dans values-fr/ (docs/architecture.md § 3, règle 2).

  Les noms de jours et les dates ne sont pas ici : ils viennent de java.time, qui les rend déjà
  dans la langue de l'appareil. Les recopier en ressources serait une traduction de plus à tenir.
-->
<resources>

  <!-- Le canal de notification, tel qu'il apparaît dans les réglages système d'Android.
       Silencieux par défaut, et désactivable de là (SPEC.md § 5.5.1). -->
  <string name="watch_channel_name">Watched trips</string>
  <string name="watch_channel_description">One check an hour before each watched departure. Silent by default.</string>

  <!-- Notifications. Le contenu suit la spec : la ligne concernée, la nature du problème, et la
       nouvelle heure de départ conseillée s'il en existe une. -->
  <string name="watch_notification_delayed_line">%1$s is running late</string>
  <string name="watch_notification_delayed">Your trip is running late</string>
  <string name="watch_notification_cancelled_line">%1$s is cancelled</string>
  <string name="watch_notification_cancelled">A service on your trip is cancelled</string>
  <string name="watch_notification_cancelled_body">This service will not run.</string>
  <string name="watch_notification_disrupted_line">Disruption on %1$s</string>
  <string name="watch_notification_disrupted">Disruption on your trip</string>
  <string name="watch_notification_impossible">No trip found</string>
  <string name="watch_notification_impossible_body">The server no longer offers this trip. Open Escale to search again.</string>
  <string name="watch_notification_fine">Nothing to report</string>
  <string name="watch_notification_fine_body">Departure at %1$s, as scheduled.</string>
  <string name="watch_notification_suggested">Suggested departure: %1$s.</string>
  <plurals name="watch_notification_delay">
    <item quantity="one">%1$d minute late.</item>
    <item quantity="other">%1$d minutes late.</item>
  </plurals>

  <!-- L'écran d'activation, ouvert depuis un trajet favori. -->
  <string name="watch_title">Notify me before departure</string>
  <string name="watch_sheet_title">Watch this trip</string>
  <string name="watch_close">Close</string>
  <string name="watch_enable">Watch this trip</string>

  <!-- SPEC.md § 5.5.1 : « L'écran d'activation explique en une phrase que l'application enverra
       une requête au serveur configuré une heure avant chaque trajet surveillé, et que ces
       requêtes, à heure fixe, révèlent des habitudes de déplacement. » -->
  <string name="watch_privacy_notice">Escale will send one request to the MOTIS server you have configured, one hour before each watched departure; because those requests leave at fixed times, they reveal your travel habits to whoever watches that server or the network.</string>

  <string name="watch_summary_off">One check an hour before departure, if you turn it on.</string>
  <string name="watch_stop">Stop watching</string>
  <string name="watch_summary_format">%1$s · %2$s</string>
  <string name="watch_value_separator">", "</string>

  <string name="watch_time_label">Usual departure time</string>
  <string name="watch_time_action">Change the departure time</string>
  <string name="watch_time_confirm">Set time</string>
  <string name="watch_days_label">Days</string>
  <string name="watch_once_on">Once, on %1$s</string>
  <string name="watch_repeat_hint">Without a repeat, the watch runs once and then turns itself off.</string>

  <string name="watch_threshold_label">Warn me from</string>
  <plurals name="watch_threshold_value">
    <item quantity="one">%1$d min</item>
    <item quantity="other">%1$d min</item>
  </plurals>
  <string name="watch_notify_always">Notify me even if everything is fine</string>

  <plurals name="watch_limit_reached">
    <item quantity="one">You are already watching %1$d trip. Turn that one off first.</item>
    <item quantity="other">You are already watching %1$d trips. Turn one of them off first.</item>
  </plurals>

  <!-- Refus de POST_NOTIFICATIONS : la surveillance reste proposée, sans notification, et son
       résultat s'affiche ici à l'ouverture de l'application (SPEC.md § 5.5.1). -->
  <string name="watch_notifications_off">Notifications are turned off. The trip is still checked, and the result appears here.</string>

  <!-- Le résultat de la dernière vérification, visible sans notification. -->
  <string name="watch_last_check">Checked at %1$s · %2$s</string>
  <string name="watch_last_check_none">Not checked yet.</string>
  <string name="watch_status_nothing">nothing to report</string>
  <string name="watch_status_delayed">delay reported</string>
  <string name="watch_status_cancelled">service cancelled</string>
  <string name="watch_status_disrupted">disruption reported</string>
  <string name="watch_status_impossible">no trip found</string>
</resources>
