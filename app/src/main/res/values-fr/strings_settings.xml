  <string name="settings_walking_speed_title">Vitesse de marche</string>
  <string name="settings_walking_speed_description">L\'allure qu\'Escale vous suppose à pied. Une allure plus lente allonge les portions à pied et écarte les correspondances trop justes.</string>
  <string name="settings_walking_speed_very_slow">Très lente, environ 3 km/h</string>
  <string name="settings_walking_speed_slow">Lente, environ 3,6 km/h</string>
  <string name="settings_walking_speed_normal">Normale, environ 4,3 km/h</string>
  <string name="settings_walking_speed_fast">Rapide, environ 5 km/h</string>
  <string name="settings_walking_speed_very_fast">Très rapide, environ 6 km/h</string>

  <string name="settings_pedestrian_profile_title">Profil piéton</string>
  <string name="settings_pedestrian_profile_description">Le profil « fauteuil roulant » évite les escaliers, les marches et les cheminements trop pentus ou trop étroits. Il change l\'itinéraire lui-même, pas seulement son affichage.</string>
  <string name="settings_pedestrian_profile_foot">À pied</string>
  <string name="settings_pedestrian_profile_wheelchair">Fauteuil roulant</string>

  <string name="settings_cycling_speed_title">Vitesse à vélo</string>
  <string name="settings_cycling_speed_description">L\'allure qu\'Escale vous suppose à vélo, personnel comme en libre-service.</string>
  <string name="settings_cycling_speed_very_slow">Très lente, environ 12 km/h</string>
  <string name="settings_cycling_speed_slow">Lente, environ 15 km/h</string>
  <string name="settings_cycling_speed_normal">Normale, environ 18 km/h</string>
  <string name="settings_cycling_speed_fast">Rapide, environ 22 km/h</string>
  <string name="settings_cycling_speed_very_fast">Très rapide, environ 26 km/h</string>

  <string name="settings_elevation_costs_title">Dénivelé à vélo</string>
  <string name="settings_elevation_costs_description">Jusqu\'où un itinéraire à vélo peut s\'allonger pour éviter une côte. Éviter le dénivelé donne des trajets plus plats, mais plus longs.</string>
  <string name="settings_elevation_costs_none">Ne pas tenir compte des côtes</string>
  <string name="settings_elevation_costs_low">Éviter les côtes les plus raides</string>
  <string name="settings_elevation_costs_high">Éviter les côtes autant que possible</string>

  <string name="settings_transfer_margin_title">Temps de correspondance supplémentaire</string>
  <string name="settings_transfer_margin_description">Ajouté à chaque correspondance, en plus du temps prévu par l\'exploitant. Utile si passer d\'un quai à l\'autre vous demande plus de temps.</string>
  <string name="settings_transfer_margin_none">Aucun temps supplémentaire</string>
  <plurals name="settings_transfer_margin_minutes">
    <item quantity="one">%1$d minute de plus</item>
    <!-- Catégorie CLDR « many » du français : elle ne vaut que pour les millions (1000000,
         2000000…), et lint l'exige dès qu'un pluriel porte un nombre. La construction « 2 millions
         DE X » suppose le nombre écrit en toutes lettres ; avec %d, qui rend « 2000000 », elle
         serait fautive. La forme reprend donc « other ». -->
    <item quantity="many">%1$d minutes de plus</item>
    <item quantity="other">%1$d minutes de plus</item>
  </plurals>

  <string name="settings_max_transfers_title">Nombre maximal de correspondances</string>
  <string name="settings_max_transfers_description">Les trajets qui comptent davantage de correspondances ne sont pas proposés. Moins de correspondances donne en général un trajet plus long.</string>
  <string name="settings_max_transfers_unlimited">Sans limite</string>
  <string name="settings_max_transfers_none">Trajets directs seulement</string>
  <plurals name="settings_max_transfers_count">
    <item quantity="one">%1$d correspondance au plus</item>
    <!-- Voir la note ci-dessus : forme « many » exigée par lint, identique à « other ». -->
    <item quantity="many">%1$d correspondances au plus</item>
    <item quantity="other">%1$d correspondances au plus</item>
  </plurals>

  <string name="settings_require_bike_transport_title">Uniquement les services acceptant les vélos</string>
  <string name="settings_require_bike_transport_description">Ne retient que les trains, cars et bateaux qui embarquent les vélos.</string>

  <string name="settings_rental_form_factors_title">Véhicules en libre-service</string>
  <string name="settings_rental_form_factors_description">Les véhicules partagés qu\'Escale peut proposer, pour un trajet entier comme pour rejoindre ou quitter un arrêt. Un type décoché n\'apparaît nulle part. Au moins un type doit rester coché.</string>
  <string name="settings_rental_form_factors_all">Tous les types acceptés</string>
  <string name="settings_rental_bicycle">Vélo</string>
  <string name="settings_rental_cargo_bicycle">Vélo cargo</string>
  <string name="settings_rental_car">Voiture</string>
  <string name="settings_rental_moped">Cyclomoteur</string>
  <string name="settings_rental_scooter_standing">Trottinette</string>
  <string name="settings_rental_scooter_seated">Scooter assis</string>
  <string name="settings_rental_other">Autre véhicule</string>

  <string name="settings_theme_title">Thème</string>
  <string name="settings_theme_description">Couleurs claires ou sombres, quelle que soit l\'heure.</string>
  <string name="settings_theme_system">Comme le système</string>
  <string name="settings_theme_light">Clair</string>
  <string name="settings_theme_dark">Sombre</string>

  <string name="settings_language_title">Langue</string>
  <string name="settings_language_description">Choisissez la langue d\'affichage d\'Escale, sur l\'écran « Langue de l\'application » d\'Android. Tant que vous n\'y touchez pas, Escale suit la langue de votre appareil.</string>
  <string name="settings_language_unavailable">Cet appareil ne propose pas d\'écran de langue par application. Vous pouvez tout de même changer la langue de toutes les applications dans les réglages d\'Android.</string>

  <string name="settings_clock_format_title">Format de l\'heure</string>
  <string name="settings_clock_format_description">La façon dont les heures de départ et d\'arrivée sont écrites.</string>
  <string name="settings_clock_format_system">Comme le système</string>
  <string name="settings_clock_format_12">Sur 12 heures (1:30 pm)</string>
  <string name="settings_clock_format_24">Sur 24 heures (13:30)</string>

  <string name="settings_show_stops_title">Afficher les arrêts sur la carte</string>
  <string name="settings_show_stops_description">Gares, stations et arrêts, dès que l\'échelle le permet. Désactivé, ils restent masqués à tous les niveaux de zoom.</string>
  <string name="settings_show_rentals_title">Afficher le libre-service sur la carte</string>
  <string name="settings_show_rentals_description">Stations et véhicules laissés en libre-service.</string>
  <string name="settings_show_points_of_interest_title">Afficher les points d\'intérêt sur la carte</string>
  <string name="settings_show_points_of_interest_description">Services publics, monuments, parcs et équipements qui aident à se repérer.</string>

  <!-- Entrée vers l'écran des favoris et de l'historique (SPEC.md § 5.5). -->
  <string name="settings_favorites_title">Favoris et historique</string>
  <string name="settings_favorites_description">Domicile, travail, lieux enregistrés, arrêts, trajets et recherches récentes.</string>

  <string name="settings_history_enabled_title">Conserver les recherches récentes</string>
  <string name="settings_history_enabled_description">Vos recherches récentes restent sur cet appareil et ne sont envoyées nulle part.</string>

  <string name="settings_clear_history_title">Effacer les recherches récentes</string>
  <string name="settings_clear_history_description">Supprime la liste des lieux que vous avez cherchés.</string>
  <string name="settings_clear_history_confirmation">La liste des lieux que vous avez cherchés sera supprimée de cet appareil. Vos favoris sont conservés.</string>

  <string name="settings_clear_tile_cache_title">Effacer le cache de la carte</string>
  <string name="settings_clear_tile_cache_description">Libère la place occupée par les tuiles de carte déjà téléchargées.</string>
  <string name="settings_clear_tile_cache_confirmation">Les tuiles de carte enregistrées sur cet appareil seront supprimées. La carte les téléchargera de nouveau au fil de vos déplacements.</string>

  <string name="settings_clear_results_cache_title">Effacer les résultats en mémoire</string>
  <string name="settings_clear_results_cache_description">Les trajets gardés en mémoire pour la recherche en cours.</string>
  <string name="settings_clear_results_cache_confirmation">Les trajets gardés en mémoire pour la recherche en cours seront supprimés. La prochaine recherche interrogera de nouveau le serveur.</string>

  <!-- « enregistrés » et non « en mémoire » : contrairement aux résultats de recherche, ce cache
       est sur le disque et survit à la fermeture de l\'application. C\'est précisément ce qui
       compte pour la vie privée (SPEC.md § 11), le libellé doit le dire. -->
  <string name="settings_clear_geocode_cache_title">Effacer les lieux enregistrés</string>
  <string name="settings_clear_geocode_cache_description">Les adresses et arrêts trouvés en cherchant, gardés 24 heures dans le stockage de l\'appareil.</string>
  <string name="settings_clear_geocode_cache_confirmation">Les adresses et les arrêts trouvés en cherchant, conservés 24 heures sur cet appareil, seront supprimés.</string>

  <string name="settings_reset_title">Rétablir les réglages par défaut</string>
  <string name="settings_reset_description">Remet chaque réglage de cet écran à sa valeur d\'origine.</string>
  <string name="settings_reset_confirmation">Chaque réglage de cet écran revient à sa valeur d\'origine. Le serveur configuré, vos favoris et vos recherches récentes sont conservés.</string>

