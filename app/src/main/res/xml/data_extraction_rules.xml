<?xml version="1.0" encoding="utf-8"?>
<!--
  Escale ne sort **rien** de l'appareil (SPEC.md § 11) : ni sauvegarde dans le nuage, ni transfert
  d'appareil à appareil.

  `android:allowBackup="false"` au manifeste suffirait presque, mais pas tout à fait : depuis
  Android 12, il ne gouverne que la sauvegarde automatique vers le nuage, et **le transfert
  d'appareil à appareil reste actif** tant qu'il n'est pas exclu ici. Ce fichier ferme donc la
  seconde porte, explicitement, domaine par domaine.

  La base Room contient le domicile, le lieu de travail, les arrêts favoris et l'historique complet
  des recherches ; le DataStore contient le serveur configuré et les préférences. Rien de tout cela
  n'a à transiter par un service tiers, fût-il celui du constructeur.

  Conséquence assumée et annoncée dans PRIVACY.md : changer de téléphone fait perdre ces données,
  sans recours, puisqu'aucun export n'existe dans l'application.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </device-transfer>
</data-extraction-rules>
