<?xml version="1.0" encoding="utf-8"?>
<!--
  Chaînes communes à toute l'application : nom, accroche, actions génériques, erreurs générales.
  Les chaînes propres à un écran vont dans strings_<ecran>.xml (docs/architecture.md § 3, règle 2).
-->
<resources>
  <!-- Nom propre : il ne se traduit pas. -->
  <string name="app_name" translatable="false">Escale</string>
