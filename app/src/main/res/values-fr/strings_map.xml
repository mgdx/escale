  <string name="map_stop_departures">Prochains départs</string>
  <string name="map_stop_close">Fermer le détail de l\'arrêt</string>
  <!-- Le mode, puis le numéro de ligne : « Métro 14 ». -->
  <string name="map_stop_line_description">%1$s %2$s</string>

