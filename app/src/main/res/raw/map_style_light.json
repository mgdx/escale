        [
          "!=",
          [
            "get",
            "rail"
          ],
          true
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-max-angle": 30,
        "text-padding": 2
      },
      "paint": {
        "text-color": "#6a6560",
        "text-halo-color": "#f8f4f0",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "poi-toilets",
      "type": "symbol",
      "source": "motis",
      "source-layer": "pois",
      "minzoom": 15,
      "filter": [
        "match",
        [
          "get",
          "amenity"
        ],
        [
          "toilets"
        ],
        true,
        false
      ],
      "layout": {
        "visibility": "visible",
        "icon-image": "icon-toilet",
        "icon-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          16,
          0.45,
          18,
          0.62
        ],
        "icon-padding": 4,
        "text-field": [
          "step",
          [
            "zoom"
          ],
          "",
          16,
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-anchor": "top",
        "text-offset": [
          0,
          0.8
        ],
        "text-max-width": 8,
        "text-optional": true,
        "symbol-sort-key": 100
      },
      "paint": {
        "icon-color": "#8a919c",
        "text-color": "#8a857f",
        "text-halo-color": "#f8f4f0",
        "text-halo-width": 1.2
