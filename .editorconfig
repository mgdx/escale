# Conventions d'édition du dépôt Escale.
# CLAUDE.md impose deux espaces d'indentation et les conventions ktlint par défaut.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.md]
# Deux espaces en fin de ligne sont un retour à la ligne en Markdown.
trim_trailing_whitespace = false

[gradlew.bat]
end_of_line = crlf

[*.{webp,png,jar}]
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
