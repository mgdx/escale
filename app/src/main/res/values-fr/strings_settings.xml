  <string name="server_settings_cleartext_title">Connexion en clair</string>
  <string name="server_settings_cleartext_message">%1$s est contacté en http://, sans chiffrement. Toute personne présente sur le réseau peut lire ou modifier ce qu\'Escale envoie et reçoit, y compris les lieux que vous recherchez. N\'acceptez que pour un serveur situé sur un réseau de confiance.</string>
  <string name="server_settings_cleartext_accept">Accepter et continuer</string>

  <string name="server_settings_switch_title">Changer de serveur ?</string>
  <string name="server_settings_switch_message">Escale utilisera %1$s. Les caches de résultats, de géocodage et de tuiles sont vidés.</string>
  <string name="server_settings_switch_favorites">Vos favoris et votre historique sont conservés. Un arrêt enregistré en favori peut ne pas être reconnu par le nouveau serveur : il reste alors affiché avec ses coordonnées et un signalement discret, et n\'est jamais supprimé.</string>
  <string name="server_settings_switch_untested">Ce serveur n\'a pas passé le test de connexion. Les recherches risquent de ne pas fonctionner.</string>
