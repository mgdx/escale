<?xml version="1.0" encoding="utf-8"?>
<!--
  Chaînes de l'écran d'accueil et de la carte (SPEC.md § 5.1 et § 5.7).
  Une chaîne ajoutée ici l'est aussi dans values-fr/ (docs/architecture.md § 3, règle 2).
-->
<resources>
  <!-- La carte elle-même, pour les lecteurs d'écran. Le second libellé remplace le premier dès
       qu'un trajet y est tracé : l'information ne doit pas tenir au seul dessin (SPEC.md § 9). -->
  <string name="map_content_description">Map</string>
  <string name="map_content_description_journey">Map showing the selected journey</string>

  <!-- Bouton de position, trois états (SPEC.md § 5.1). Le libellé, et pas seulement la couleur,
       distingue les états : aucune information n'est portée par la couleur seule (SPEC.md § 9). -->
  <string name="map_locate_unknown">Show my location</string>
  <string name="map_locate_centered">Centred on my location. Tap to follow me</string>
  <string name="map_locate_following">Following my location. Tap to stop</string>

  <!-- Permission refusée : une phrase, et le chemin vers les réglages système (SPEC.md § 5.1). -->
  <string name="map_location_denied_title">Location unavailable</string>
  <string name="map_location_denied_message">Escale needs the location permission to show where you are. Everything else works without it.</string>
  <string name="map_location_denied_action">Open system settings</string>
  <string name="map_dismiss">Close</string>

  <!-- Appui long sur la carte (SPEC.md § 5.1). -->
  <string name="map_pick_departure">Start from here</string>
  <string name="map_pick_destination">Go to here</string>

  <!-- Attribution, visible en permanence (SPEC.md § 4.2 et § 5.7). -->
  <string name="map_attribution_short" translatable="false">© OpenStreetMap</string>
  <string name="map_attribution_button">Map data sources</string>
  <string name="map_attribution_title">Map data</string>
  <string name="map_attribution_openstreetmap">© OpenStreetMap contributors</string>
  <string name="map_attribution_openstreetmap_link">openstreetmap.org/copyright</string>
  <string name="map_attribution_transitous">Timetables from the Transitous community</string>
  <string name="map_attribution_transitous_link">transitous.org/sources</string>

  <!-- Serveur sans tuiles : un message discret, aucun repli sur un tiers (SPEC.md § 5.7). -->
  <string name="map_tiles_unavailable">This server provides no map background.</string>

  <!-- Les libellés de mode des marqueurs d'arrêt ne sont pas ici : ils vivent dans
       strings_results.xml et la carte les réutilise tels quels. Le mode est toujours écrit en
       toutes lettres pour les lecteurs d'écran — le pictogramme seul ne dirait rien, et la couleur
       encore moins (SPEC.md § 9). -->
  <!-- Infobulle d'un arrêt : le nom, les lignes desservies, et le chemin vers les départs. -->
  <plurals name="map_stop_lines_served">
    <item quantity="one">%d line served</item>
    <item quantity="other">%d lines served</item>
  </plurals>
  <string name="map_stop_lines_loading">Loading lines\u2026</string>
  <string name="map_stop_lines_unavailable">Lines could not be loaded.</string>
  <string name="map_stop_lines_none">No line serves this stop.</string>
  <string name="map_stop_departures">Next departures</string>
  <string name="map_stop_close">Close stop details</string>
  <!-- Le mode, puis le numéro de ligne : « Metro 14 ». -->
  <string name="map_stop_line_description">%1$s %2$s</string>

  <!-- Libre-service sur la carte (SPEC.md § 5.7). Le type de véhicule est écrit en toutes lettres
       pour les lecteurs d'écran : le pictogramme seul ne dirait rien, et la couleur encore moins
       (SPEC.md § 9). -->
  <string name="map_rental_form_bicycle">Bike</string>
  <string name="map_rental_form_scooter">Scooter</string>
  <string name="map_rental_form_moped">Moped</string>
  <string name="map_rental_form_car">Car</string>
  <string name="map_rental_form_other">Shared vehicle</string>

  <!-- Les deux familles de marqueurs. Elles se distinguent déjà par la forme de leur pastille sur
       la carte ; le libellé le dit en toutes lettres dans l'infobulle. -->
  <string name="map_rental_kind_station">Docking station</string>
  <string name="map_rental_kind_vehicle">Free-floating vehicle</string>

  <!-- Infobulle d'une station : nom, véhicules disponibles, places libres, lien vers l'exploitant. -->
  <plurals name="map_rental_vehicles_available">
    <item quantity="one">%d vehicle available</item>
    <item quantity="other">%d vehicles available</item>
  </plurals>
  <plurals name="map_rental_docks_available">
    <item quantity="one">%d free dock</item>
    <item quantity="other">%d free docks</item>
  </plurals>
  <string name="map_rental_not_renting">Temporarily closed for hire</string>
  <string name="map_rental_not_returning">Temporarily closed for returns</string>
  <string name="map_rental_open_app">Open the operator app</string>
  <string name="map_rental_close">Close rental details</string>

  <!-- Parcours des arrêts affichés, la voie d'accès des lecteurs d'écran à la carte (SPEC.md § 9).
       MapLibre rend la carte comme une vue unique : ses marqueurs ne sont pas atteignables un à un.
       Cette liste reprend exactement ce que la carte montre, à l'échelle où elle le montre. -->
  <string name="map_browse_stops">Browse the stops on screen</string>
  <string name="map_browse_stops_title">Stops on screen</string>
  <string name="map_browse_stops_empty">No stop is shown at this zoom level. Zoom in or move the map.</string>
  <plurals name="map_browse_stops_truncated">
    <item quantity="one">Only %d stop, the nearest one, is listed. Zoom in to narrow the list.</item>
    <item quantity="other">Only the %d nearest stops are listed. Zoom in to narrow the list.</item>
  </plurals>
  <plurals name="map_browse_stops_count">
    <item quantity="one">%d stop on screen</item>
    <item quantity="other">%d stops on screen</item>
  </plurals>
  <string name="map_browse_stops_open">Show this stop</string>

